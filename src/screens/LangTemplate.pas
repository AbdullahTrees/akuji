{ The translation template, assets/lang/akuji.pot, built from en.po - the
  game's English and the base every other language is laid over.

  Written by the game itself (akuji --write-pot): every context en.po has,
  its English as the msgid a translator translates, and its notes. See
  Translation for the format and README.md, "Translating", for the workflow. }

unit LangTemplate;

{$MODE DELPHI}{$H+}

interface

uses
  Classes, SysUtils, Translation;

type
  TTemplateEntries = array of TPoEntry;

{ Every translatable string, in en.po's order. Str is empty; Id is en.po's
  English as PO text (line breaks, not \n codes). }
function TemplateEntries(const GameDir: string): TTemplateEntries;

{ The whole .pot file. }
function TemplateText(const GameDir: string): string;

implementation

uses
  Version;

function TemplateEntries(const GameDir: string): TTemplateEntries;
var
  En: TPoFile;
  I, N: Integer;
begin
  SetLength(Result, 0);
  En := TPoFile.Create;
  try
    En.LoadFromFile(IncludeTrailingPathDelimiter(GameDir) + 'lang'
                    + PathDelim + 'en.po');
    N := 0;
    SetLength(Result, En.Count);
    for I := 0 to En.Count - 1 do
      if En.Entries[I].Str <> '' then
      begin
        Result[N] := Default(TPoEntry);
        Result[N].Context := En.Entries[I].Context;
        Result[N].Id := En.Entries[I].Str;
        Result[N].Comment := En.Entries[I].Comment;
        Inc(N);
      end;
    SetLength(Result, N);
  finally
    En.Free;
  end;
end;

function TemplateText(const GameDir: string): string;
var
  E: TTemplateEntries;
  Out, Notes: TStringList;
  I, K: Integer;
begin
  E := TemplateEntries(GameDir);
  Out := TStringList.Create;
  Notes := TStringList.Create;
  try
    Out.Add('# Translation template for ' + APP_NAME + '.');
    Out.Add('#');
    Out.Add('# Written by the game: akuji --write-pot. Do not edit this file;');
    Out.Add('# copy it to <language code>.po (ja.po, fr.po, ...) and fill in');
    Out.Add('# the msgstr lines, or open it in Poedit or any PO editor.');
    Out.Add('#');
    Out.Add('# In the dialogue, a line break is a line break (three lines to a');
    Out.Add('# box). \k waits for a key and starts the next box, \e ends the');
    Out.Add('# message, \w ends it with the Yes/No prompt. Keep \e and \w as');
    Out.Add('# the English has them; add \k wherever the text needs more boxes.');
    Out.Add('# A box ending in \w holds two lines - the prompt takes the third.');
    Out.Add('#');
    Out.Add('# {JUMP}, {FIRE}, {PAUSE}, {UP}, {DOWN}, {LEFT} and {RIGHT} are');
    Out.Add('# replaced by the key the player has bound to that action - "Z",');
    Out.Add('# "R CTRL", "LEFT" - when the line is shown.');
    Out.Add('#');
    Out.Add('# An empty msgstr shows the English. To choose the language, set');
    Out.Add('# lang=<code> under [language] in system.ini. If the default font');
    Out.Add('# lacks your script, name one in assets/fonts/ below. The');
    Out.Add('# options screen shows X-Akuji-Menu-Name - a short code such as');
    Out.Add('# FR, at most seven capitals: its font has nothing else.');
    Out.Add('msgid ""');
    Out.Add('msgstr ""');
    Out.Add('"Project-Id-Version: ' + APP_NAME + ' ' + APP_VERSION + '\n"');
    Out.Add('"Language: \n"');
    Out.Add('"MIME-Version: 1.0\n"');
    Out.Add('"Content-Type: text/plain; charset=UTF-8\n"');
    Out.Add('"Content-Transfer-Encoding: 8bit\n"');
    Out.Add('"X-Akuji-Font: \n"');
    Out.Add('"X-Akuji-Font-Size: \n"');
    Out.Add('"X-Akuji-Menu-Name: \n"');
    for I := 0 to High(E) do
    begin
      Out.Add('');
      Notes.Text := E[I].Comment;
      for K := 0 to Notes.Count - 1 do
        Out.Add('#. ' + Notes[K]);
      Out.Add(PoQuote('msgctxt', E[I].Context));
      Out.Add(PoQuote('msgid', E[I].Id));
      Out.Add('msgstr ""');
    end;
    Out.LineBreak := #10;
    Result := Out.Text;
  finally
    Notes.Free;
    Out.Free;
  end;
end;

end.
