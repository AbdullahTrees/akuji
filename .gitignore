# Build output
bin/
lib/
*.exe
*.o
*.ppu
*.compiled
*.res
*.or

# The alternate project tools/build.sh writes for AKUJI_EXE. Its trap
# removes it; this is in case a build is interrupted before that runs.
akuji-alt.lpi

# Lazarus session state, which is per-developer and not part of the project
*.lps
backup/

# Test output
selftest.log

# Editor and OS noise
*.bak
*.tmp
*.orig
.DS_Store
Thumbs.db

# Free Pascal fetched by tools/fetch-fpc.sh, and its download cache
.toolchain/
