#: data/tk001.dat:1
msgctxt "tk001:0"
msgid ""
"It's time to search for the nine\n"
"stones the hero sealed off! \\e"
msgstr ""
"It's time to search for the nine\n"
"stones the hero sealed off! \\e"

#: data/tk001.dat:2
msgctxt "tk001:1"
msgid ""
"Those things are \"Mana Stones.\" \\kIf you gather enough of them, \n"
"your LIFE will increase!  \\e"
msgstr ""
"Those things are \"Mana Stones.\" \\kIf you gather enough of them, \n"
"your LIFE will increase!  \\e"

#: data/tk001.dat:3
msgctxt "tk001:2"
msgid ""
"Press the arrow key twice to\n"
"perform a Dash move.\\kYou should try it right away! \\e"
msgstr ""
"Press the arrow key twice to\n"
"perform a Dash move.\\kYou should try it right away! \\e"

#: data/tk001.dat:4
msgctxt "tk001:3"
msgid ""
"Those things are \"Mana Stones.\" \\kBut it seems they're already  \n"
"gone... \\e"
msgstr ""
"Those things are \"Mana Stones.\" \\kBut it seems they're already  \n"
"gone... \\e"

#: data/tk001.dat:5
msgctxt "tk001:4"
msgid ""
"Once you've achieved \"Rank S\" \n"
"you can come here.\\kAfter clearing the game, select \n"
"\"NEW GAME\" on the title screen\n"
"and head over here. \\e"
msgstr ""
"Once you've achieved \"Rank S\" \n"
"you can come here.\\kAfter clearing the game, select \n"
"\"NEW GAME\" on the title screen\n"
"and head over here. \\e"

