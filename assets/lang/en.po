msgstr ""
"Project-Id-Version: Akuji the Demon\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Akuji-Menu-Name: EN\n"

#. The window's title bar.
msgctxt "window.title"
msgid "Akuji the Demon"
msgstr "Akuji the Demon"

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:0"
msgid "A demon named \"Akuji\" once  "
msgstr "A demon named \"Akuji\" once  "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:1"
msgid "terrorized this land. "
msgstr "terrorized this land. "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:2"
msgid "Akuji's mischief brought  "
msgstr "Akuji's mischief brought  "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:3"
msgid "misfortune upon the people. "
msgstr "misfortune upon the people. "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:4"
msgid "One day, a hero came to the   "
msgstr "One day, a hero came to the   "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:5"
msgid "kingdom to slay Akuji."
msgstr "kingdom to slay Akuji."

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:6"
msgid "After an amazing battle, the  "
msgstr "After an amazing battle, the  "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:7"
msgid "hero was victorious.          "
msgstr "hero was victorious.          "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:8"
msgid "The hero was praised and wed"
msgstr "The hero was praised and wed"

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:9"
msgid "the princess to become the king."
msgstr "the princess to become the king."

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:10"
msgid "But Akuji's powers were only    "
msgstr "But Akuji's powers were only    "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:11"
msgid "sealed in nine stones."
msgstr "sealed in nine stones."

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:12"
msgid "The stones were hidden in a "
msgstr "The stones were hidden in a "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:13"
msgid "deep labyrinth.   "
msgstr "deep labyrinth.   "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:14"
msgid "    And now...      "
msgstr "    And now...      "

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:16"
msgid "Akuji is recovering them"
msgstr "Akuji is recovering them"

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:17"
msgid "to seek revenge on the hero..."
msgstr "to seek revenge on the hero..."

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:18"
msgid "In this underground labyrinth,"
msgstr "In this underground labyrinth,"

#. Opening narration, drawn in pairs under each picture: lines 0 and 1, 2 and 3, and so on. Leading spaces move a line right.
msgctxt "opening:19"
msgid "the nine stones lie sealed.     "
msgstr "the nine stones lie sealed.     "

#. Ending narration, two lines under each slide.
msgctxt "ending:0"
msgid "    Light covered Akuji as"
msgstr "    Light covered Akuji as"

#. Ending narration, two lines under each slide.
msgctxt "ending:1"
msgid "    he broke the last seal... "
msgstr "    he broke the last seal... "

#. Ending narration, two lines under each slide.
msgctxt "ending:2"
msgid " He's transforming back!"
msgstr " He's transforming back!"

#. Ending narration, two lines under each slide.
msgctxt "ending:4"
msgid "What's going on?!?"
msgstr "What's going on?!?"

#. Ending narration, two lines under each slide.
msgctxt "ending:6"
msgid "His horns are all that grew..!"
msgstr "His horns are all that grew..!"

#. Ending narration, two lines under each slide.
msgctxt "ending:8"
msgid "  Akuji learned a lesson. "
msgstr "  Akuji learned a lesson. "

#. Ending narration, two lines under each slide.
msgctxt "ending:10"
msgid "Disgusted, he decides to  "
msgstr "Disgusted, he decides to  "

#. Ending narration, two lines under each slide.
msgctxt "ending:11"
msgid "not cause mischief anymore. "
msgstr "not cause mischief anymore. "

